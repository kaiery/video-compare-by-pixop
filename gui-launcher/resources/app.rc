#pragma code_page(65001)
#include <windows.h>
#include "resource.h"

IDR_MAIN_MENU MENU
BEGIN
    POPUP "文件(&F)"
    BEGIN
        MENUITEM "保存会话…", IDM_SESSION_SAVE
        MENUITEM "打开会话…", IDM_SESSION_OPEN
        MENUITEM SEPARATOR
        MENUITEM "导入引擎参数文件 (.opt)…", IDM_OPT_IMPORT
        MENUITEM "导出引擎参数文件 (.opt)…", IDM_OPT_EXPORT
        MENUITEM "查看配置来源与合并结果", IDM_CONFIG_INSPECT
        MENUITEM SEPARATOR
        MENUITEM "退出(&X)", IDM_EXIT
    END
    POPUP "帮助(&H)"
    BEGIN
        MENUITEM "关于(&A)", IDM_ABOUT
    END
END

IDD_INPUT_EDIT DIALOGEX 0, 0, 430, 220
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "待比较输入"
FONT 10, "Microsoft YaHei UI"
BEGIN
    LTEXT "输入类型(&T)", -1, 12, 12, 80, 12
    COMBOBOX IDC_DIALOG_KIND, 100, 10, 185, 90, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "路径或地址(&P)", -1, 12, 40, 80, 12
    EDITTEXT IDC_DIALOG_PATH, 12, 57, 333, 20, ES_AUTOHSCROLL
    PUSHBUTTON "浏览(&B)…", IDC_DIALOG_BROWSE, 351, 57, 65, 20
    LTEXT "独立滤镜(&F)", -1, 12, 90, 80, 12
    COMBOBOX IDC_FILTER_MODE, 100, 87, 185, 90, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    EDITTEXT IDC_FILTER_TEXT, 12, 114, 404, 30, ES_MULTILINE | ES_AUTOVSCROLL | WS_VSCROLL
    PUSHBUTTON "全部逐视频设置（11 项）…", IDC_OVERRIDE_SETTINGS, 12, 150, 198, 22
    LTEXT "条目配置随排序移动。", -1, 224, 154, 190, 16
    LTEXT "", IDC_DIALOG_ERROR, 12, 177, 404, 16
    DEFPUSHBUTTON "确定", IDOK, 270, 194, 70, 20
    PUSHBUTTON "取消", IDCANCEL, 346, 194, 70, 20
END

IDD_SETTINGS DIALOGEX 0, 0, 670, 460
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "全部设置"
FONT 10, "Microsoft YaHei UI"
BEGIN
    LISTBOX IDC_SETTINGS_PAGES, 10, 10, 105, 306, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    LTEXT "未启用的值沿用默认或继承；启用后允许保留显式空值。", IDC_SETTINGS_NOTE, 125, 10, 530, 25
    EDITTEXT IDC_SETTINGS_PREVIEW, 10, 338, 650, 83, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_HSCROLL
    PUSHBUTTON "校验 / 预览草稿", IDC_SETTINGS_VALIDATE, 10, 430, 98, 22
    PUSHBUTTON "恢复本页默认", IDC_SETTINGS_RESET, 116, 430, 90, 22
    DEFPUSHBUTTON "确定", IDOK, 506, 430, 72, 22
    PUSHBUTTON "取消", IDCANCEL, 588, 430, 72, 22
END

IDD_RUN_LOG DIALOGEX 0, 0, 620, 390
STYLE DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "比较任务 · 运行日志"
FONT 10, "Microsoft YaHei UI"
BEGIN
    LTEXT "尚未启动任务", IDC_RUN_STATE, 10, 10, 600, 30
    EDITTEXT IDC_RUN_OUTPUT, 10, 45, 600, 300, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | ES_AUTOHSCROLL | WS_VSCROLL | WS_HSCROLL
    PUSHBUTTON "正常停止", IDC_RUN_STOP, 10, 358, 85, 22
    PUSHBUTTON "强制结束…", IDC_RUN_FORCE, 105, 358, 85, 22
    PUSHBUTTON "打开日志目录", IDC_RUN_FOLDER, 200, 358, 100, 22
    AUTOCHECKBOX "跟随刷新", IDC_RUN_FOLLOW, 318, 360, 95, 18
    PUSHBUTTON "关闭日志窗口", IDCANCEL, 495, 358, 115, 22
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,1,0
 PRODUCTVERSION 0,1,1,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "Video Compare GUI Launcher"
      VALUE "FileVersion", "0.1.1.0"
      VALUE "InternalName", "video-compare-gui"
      VALUE "OriginalFilename", "video-compare-gui.exe"
      VALUE "ProductName", "Video Compare GUI"
      VALUE "ProductVersion", "0.1.1.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
